<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Quando se agenda um Evento, carimba a data da visita no lead e no negocio. Sem isto nenhuma validation rule consegue exigir uma visita, porque uma formula nao ve Eventos.</description>
    <environments>Default</environments>
    <interviewLabel>Carimbar Visita {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Carimbar Visita</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Carimbar_o_lead</name>
        <label>Carimbar o lead</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Carimbar_o_negocio</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Data_Visita_Agendada__c</field>
            <value>
                <elementReference>$Record.StartDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <recordUpdates>
        <name>Carimbar_o_negocio</name>
        <label>Carimbar o negócio</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Data_Visita__c</field>
            <value>
                <elementReference>$Record.StartDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Carimbar_o_lead</targetReference>
        </connector>
        <!--
          Um Evento pode estar ligado a um lead (WhoId) ou a um negocio (WhatId),
          e as duas atualizacoes correm sempre: a que nao encontrar registo nao
          faz nada. E mais simples e mais barato do que decidir antes qual delas
          se aplica.
        -->
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
