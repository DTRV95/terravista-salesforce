<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Carimba a Data do 1o Contacto quando uma chamada ao lead e concluida.</description>
    <environments>Default</environments>
    <interviewLabel>Carimbar Primeiro Contacto {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Carimbar Primeiro Contacto</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Carimbar_o_lead</name>
        <label>Carimbar o lead</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Data_Primeiro_Contacto__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Data_Primeiro_Contacto__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Carimbar_o_lead</targetReference>
        </connector>
        <filterFormula>AND(
  ISPICKVAL({!$Record.Status}, &quot;Completed&quot;),
  ISPICKVAL({!$Record.TaskSubtype}, &quot;Call&quot;),
  NOT(ISBLANK({!$Record.WhoId}))
)</filterFormula>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
