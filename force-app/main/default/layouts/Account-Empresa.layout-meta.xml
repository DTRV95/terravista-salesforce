<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Construtoras, promotoras e investidores. Aqui os criterios de procura sao
      de terreno - tipo de solo, area bruta de construcao - porque e isso que
      esta gente compra. Numa pessoa isto nao faz sentido nenhum, e por isso ha
      duas layouts e nao uma.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Identificação</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>Name</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Type</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Industry</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Phone</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Website</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>OwnerId</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Critérios de procura</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Procura_Tipo_Solo__c</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Procura_ABC_Minima_m2__c</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Procura_Zonas__c</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Orcamento_Max__c</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Como decidem</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Notas_Criterios__c</field>
                </layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Morada e estrutura</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>BillingAddress</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>ParentId</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Informação de Sistema</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>CreatedById</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>LastModifiedById</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <!--
      A lista mais importante do projeto inteiro, e vem primeiro por isso.

      Abrir a Construtora Nortagua e ver, sem clicar em nada, quantas fracoes tem
      cada empreendimento e quantas ja venderam. E exatamente o relatorio que o
      Miguel reconstruia a mao ao fim da tarde - passa a ser a pagina do cliente.
    -->
    <relatedLists>
        <fields>CONTRACT.CONTRACT_NUMBER</fields>
        <fields>Nome_Empreendimento__c</fields>
        <fields>Imoveis_Total__c</fields>
        <fields>Imoveis_Vendidos__c</fields>
        <fields>Percentagem_Comercializada__c</fields>
        <fields>CONTRACT.STATUS</fields>
        <relatedList>RelatedContractList</relatedList>
    </relatedLists>
    <!--
      Quem se atende do outro lado. O cargo esta ca porque numa construtora
      importa saber se se esta a falar com quem decide ou com quem executa.
    -->
    <relatedLists>
        <fields>CONTACT.NAME</fields>
        <fields>CONTACT.TITLE</fields>
        <fields>CONTACT.PHONE</fields>
        <fields>CONTACT.EMAIL</fields>
        <relatedList>RelatedContactList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>OPPORTUNITY.NAME</fields>
        <fields>Imovel__c</fields>
        <fields>OPPORTUNITY.STAGE_NAME</fields>
        <fields>OPPORTUNITY.AMOUNT</fields>
        <fields>Dias_Sem_Atividade__c</fields>
        <fields>OPPORTUNITY.CLOSE_DATE</fields>
        <relatedList>RelatedOpportunityList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>TASK.SUBJECT</fields>
        <fields>TASK.WHO_NAME</fields>
        <fields>TASK.STATUS</fields>
        <fields>TASK.DUE_DATE</fields>
        <relatedList>RelatedActivityList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>OBJECT_FIELD</fields>
        <fields>OLD_VALUE</fields>
        <fields>NEW_VALUE</fields>
        <fields>CREATED_DATE</fields>
        <relatedList>RelatedHistoryList</relatedList>
    </relatedLists>
</Layout>
