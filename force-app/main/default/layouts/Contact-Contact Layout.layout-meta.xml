<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Depois da migracao para Person Accounts, um Contact NUNCA e um comprador -
      e uma pessoa dentro de uma empresa. O Alberto da Nortagua, a Rita dos
      Edificios do Norte.

      Por isso saiu daqui o perfil de procura inteiro (tipologia, zonas,
      orcamento, financiamento). Esses campos continuam a existir no objeto,
      porque e deles que nascem os campos __pc do Person Account - mas mostra-los
      numa ficha de contacto empresarial e pedir a alguem que os preencha para
      nada.

      O que fica e o que interessa num interlocutor: como se lhe chega, que peso
      tem na decisao, e quando reune.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Quem é</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>Name</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>AccountId</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Title</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Phone</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>MobilePhone</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Email</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Como decide</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Notas_Preferencias__c</field>
                </layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Origem e responsável</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>LeadSource</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>OwnerId</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Informação de Sistema</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>CreatedById</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>LastModifiedById</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <relatedLists>
        <fields>OPPORTUNITY.NAME</fields>
        <fields>OPPORTUNITY.STAGE_NAME</fields>
        <fields>OPPORTUNITY.AMOUNT</fields>
        <relatedList>RelatedOpportunityContactRoles</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>TASK.SUBJECT</fields>
        <fields>TASK.STATUS</fields>
        <fields>TASK.DUE_DATE</fields>
        <relatedList>RelatedActivityList</relatedList>
    </relatedLists>
</Layout>
