<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      A ficha de quem compra casa. Antes havia uma so layout de Account para
      empresas e pessoas, e um comprador particular via Industria, Website,
      Empresa-Mae e criterios de procura de TERRENO. Um consultor a ligar a um
      cliente nao le nada disso, e cada campo que nao se le esconde um que se le.

      A ordem segue a chamada telefonica: quem e, o que procura, o que sabemos
      dele, e so depois o que o sistema sugere. A morada vem no fim de proposito
      - so interessa quando ja ha visita marcada.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Quem é</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>Name</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Phone</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>PersonMobilePhone</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>PersonEmail</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>AccountSource</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>OwnerId</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>O que procura</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Perfil_Comprador__pc</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Procura_Tipologia__pc</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Procura_Zonas__pc</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Orcamento_Min__pc</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Orcamento_Max__pc</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Financiamento__pc</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>O que sabemos dele</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Notas_Preferencias__pc</field>
                </layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Sugestões do sistema</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>Sugestoes_Imoveis__c</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>Candidatos_Imoveis__c</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Morada</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>PersonMailingAddress</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <emptySpace>true</emptySpace>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Informação de Sistema</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>CreatedById</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>LastModifiedById</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <relatedLists>
        <fields>OPPORTUNITY.NAME</fields>
        <fields>OPPORTUNITY.STAGE_NAME</fields>
        <fields>OPPORTUNITY.AMOUNT</fields>
        <fields>OPPORTUNITY.CLOSE_DATE</fields>
        <relatedList>RelatedOpportunityList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>TASK.SUBJECT</fields>
        <fields>TASK.STATUS</fields>
        <fields>TASK.DUE_DATE</fields>
        <relatedList>RelatedActivityList</relatedList>
    </relatedLists>
</Layout>
