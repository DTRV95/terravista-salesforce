    <!--
      AS VISITAS ESTAO AQUI, E NAO NUM CAMPO.

      Esta lista e a razao de ser do objecto. Um campo Data_Visita__c guarda
      UMA visita; esta lista guarda todas, porque cada visita e um Evento
      ligado a esta linha pelo WhatId. Tres visitas ao mesmo imovel sao tres
      linhas aqui e continuam a ser UMA linha de interesse - o estado do
      imovel tem de ter uma verdade unica.
    -->
    <relatedLists>
        <fields>TASK.SUBJECT</fields>
        <fields>TASK.WHO_NAME</fields>
        <fields>TASK.DUE_DATE</fields>
        <fields>TASK.STATUS</fields>
        <relatedList>RelatedActivityList</relatedList>
    </relatedLists>
