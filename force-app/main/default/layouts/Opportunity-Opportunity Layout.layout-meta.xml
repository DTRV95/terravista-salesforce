<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Tres coisas mudaram aqui, e a primeira era um bug a serio.

      1. O Motivo da Perda e exigido por uma validation rule e NAO estava na
         layout. Quem tentava marcar um negocio como Perdido era impedido de
         gravar e nao tinha onde escrever o motivo - uma regra que bloqueia sem
         dar saida nao protege dados, so ensina a contornar o sistema.

      2. A comissao do consultor nao aparecia. So se via a comissao da empresa,
         que e o numero que interessa a direcao e nao a quem vende. Agora estao
         as duas, lado a lado com a margem: quem vende ve o que ganha e a empresa
         ve o que sobra.

      3. Os Dias Sem Atividade passam a estar visiveis no registo, e nao so no
         dashboard. Um sinal que so existe num relatorio semanal chega tarde.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Negócio</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>Name</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>AccountId</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Imovel__c</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>RecordTypeId</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Linha_Negocio__c</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>OwnerId</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Fase e valores</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>StageName</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Required</behavior>
                    <field>CloseDate</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Amount</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Probability</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>Dias_Sem_Atividade__c</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Motivo_Perda__c</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Comissões</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Angariador__c</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>Comissao_Terravista__c</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>Comissao_Consultor__c</field>
                </layoutItems>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>Margem_Terravista__c</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Acompanhamento</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>NextStep</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>CampaignId</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Notas</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Edit</behavior>
                    <field>Description</field>
                </layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Informação de Sistema</label>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>CreatedById</field>
                </layoutItems>
        </layoutColumns>
        <layoutColumns>
                <layoutItems>
                    <behavior>Readonly</behavior>
                    <field>LastModifiedById</field>
                </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <!--
      Os servicos vendidos. So tem conteudo no Record Type Servicos - numa venda
      de imovel esta lista fica vazia de proposito, porque por-lhe produtos faria
      o Salesforce recalcular o Amount e desfazer a comissao.
    -->
    <relatedLists>
        <fields>PRODUCT.NAME</fields>
        <fields>LINE_ITEM.QUANTITY</fields>
        <fields>LINE_ITEM.UNIT_PRICE</fields>
        <fields>LINE_ITEM.TOTAL_PRICE</fields>
        <relatedList>RelatedProductList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>CONTACT.NAME</fields>
        <fields>CONTACT.TITLE</fields>
        <fields>ROLE</fields>
        <fields>IS_PRIMARY</fields>
        <relatedList>RelatedOpportunityContactRoles</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>TASK.SUBJECT</fields>
        <fields>TASK.WHO_NAME</fields>
        <fields>TASK.STATUS</fields>
        <fields>TASK.DUE_DATE</fields>
        <relatedList>RelatedActivityList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>OBJECT_FIELD</fields>
        <fields>OLD_VALUE</fields>
        <fields>NEW_VALUE</fields>
        <fields>CREATED_DATE</fields>
        <relatedList>RelatedHistoryList</relatedList>
    </relatedLists>
</Layout>
