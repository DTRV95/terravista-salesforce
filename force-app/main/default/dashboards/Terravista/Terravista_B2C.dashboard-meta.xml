            <header>Perdidos por demora</header>
            <report>Terravista/Perdidos_Por_Demora</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
    </middleSection>
    <rightSection>
        <columnSize>Medium</columnSize>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Line</componentType>
            <footer>Meta: 2 horas. A distância até à meta é o problema.</footer>
            <header>Horas até ao 1º contacto</header>
            <report>Terravista/Latencia_Primeiro_Contacto</report>
            <sortBy>RowLabelAscending</sortBy>
        </components>
    </rightSection>
    <textColor>#000000</textColor>
    <title>Terravista — B2C</title>
    <titleColor>#000000</titleColor>
