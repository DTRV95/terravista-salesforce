<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <backgroundEndColor>#FFFFFF</backgroundEndColor>
    <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <!--
      SpecifiedUser e nao LoggedInUser, por duas razoes que coincidem.

      A primeira e de desenho: este dashboard existe para mostrar a agencia
      inteira. Corre-lo como quem o abre daria a cada pessoa uma vista parcial -
      exatamente o contrario do que se quer aqui.

      A segunda e um limite da plataforma: uma Developer Edition permite tres
      dashboards dinamicos, e os tres estao entregues a quem precisa mesmo de ver
      so o seu - B2C, B2B e Apoio ao Cliente.

      O username fica escrito, o que torna este ficheiro dependente desta org. E o
      preco de nao haver forma de o parametrizar em metadata.
    -->
    <dashboardType>SpecifiedUser</dashboardType>
    <leftSection>
        <columnSize>Medium</columnSize>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Bar</componentType>
            <footer>Comissão gerada, não leads trazidos.</footer>
            <header>Receita por campanha</header>
            <report>Terravista/Receita_por_Campanha</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Bar</componentType>
            <footer>Fila de trabalho, não indicador.</footer>
            <header>Leads sem 1º contacto</header>
            <report>Terravista/Leads_Sem_Contacto</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
    </leftSection>
    <middleSection>
        <columnSize>Medium</columnSize>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Donut</componentType>
            <footer>O denominador de tudo o resto.</footer>
            <header>Leads por origem</header>
            <report>Terravista/Leads_por_Origem</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Donut</componentType>
            <footer>Dois negócios diferentes com o mesmo nome.</footer>
            <header>B2B e B2C</header>
            <report>Terravista/Vendas_por_Linha_Negocio</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
    </middleSection>
    <rightSection>
        <columnSize>Medium</columnSize>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Bar</componentType>
            <footer>Volume sem conversão premeia a origem errada.</footer>
            <header>Conversão por origem</header>
            <report>Terravista/Conversao_por_Origem</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
    </rightSection>
    <runningUser>terravista.david@agentforce.com</runningUser>
    <textColor>#000000</textColor>
    <title>Terravista — Marketing</title>
    <titleColor>#000000</titleColor>
    <titleSize>12</titleSize>
</Dashboard>
