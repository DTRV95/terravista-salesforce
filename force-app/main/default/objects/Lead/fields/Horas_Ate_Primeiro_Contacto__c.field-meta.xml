<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Horas_Ate_Primeiro_Contacto__c</fullName>
    <description>Horas entre a entrada do lead e o primeiro contacto. Meta: 2 horas.</description>
    <formula>IF(
   OR(ISBLANK(Data_Primeiro_Contacto__c), ISBLANK(Data_Entrada__c)),
   null,
   (Data_Primeiro_Contacto__c - Data_Entrada__c) * 24)</formula>
    <label>Horas até 1º Contacto</label>
    <precision>8</precision><scale>1</scale>
    <required>false</required>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
