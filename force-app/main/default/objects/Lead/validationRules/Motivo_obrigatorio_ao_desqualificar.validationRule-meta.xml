<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Motivo_obrigatorio_ao_desqualificar</fullName>
    <active>true</active>
    <description>Garante a metrica de perdas: sem motivo nao ha analise.</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Status, "Nao Qualificado"),
  ISBLANK(TEXT(Motivo_Nao_Qualificacao__c))
)</errorConditionFormula>
    <errorDisplayField>Motivo_Nao_Qualificacao__c</errorDisplayField>
    <errorMessage>Indique o motivo da desqualificação.</errorMessage>
</ValidationRule>
