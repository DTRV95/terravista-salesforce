<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Comissao_Consultor__c</fullName>
    <description>Valor que o dono do negocio recebe.</description>
    <formula>(Comissao_Terravista__c * 0.5 * Owner.Percentagem_Comissao__c)
+ IF(Angariador__c = OwnerId, Comissao_Terravista__c * 0.5 * Owner.Percentagem_Comissao__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Comissão do Consultor</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
