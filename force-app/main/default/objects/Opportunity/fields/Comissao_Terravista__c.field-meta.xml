<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Comissao_Terravista__c</fullName>
    <description>Receita da agencia: comissao do contrato sobre o valor do negocio.</description>
    <formula>IF(
  OR(
    RecordType.DeveloperName = &quot;Servicos&quot;,
    ISBLANK(Imovel__r.Contrato__r.Comissao__c)
  ),
  0,
  Amount * Imovel__r.Contrato__r.Comissao__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Comissão Terravista</label>
    <precision>12</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
